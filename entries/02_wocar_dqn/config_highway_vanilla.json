{
  "env_type": "highway",
  "env_id": "highway-v0",
  "name_suffix": "_vanilla",
  "env_config": {
    "lanes_count": 4,
    "vehicles_count": 20,
    "duration": 40,
    "policy_frequency": 1,
    "action": {
      "type": "DiscreteMetaAction"
    },
    "observation": {
      "type": "Kinematics",
      "vehicles_count": 10,
      "features": ["presence", "x", "y", "vx", "vy"],
      "absolute": false,
      "normalize": true,
      "order": "sorted"
    }
  },
  "training_config": {
    "robust": false,
    "adv_train": false,
    "use_async_env": false,
    "per": false,
    "cpprb": false,
    "num_frames": 100000,
    "batch_size": 32,
    "gamma": 0.99,
    "lr": 0.00025,
    "act_epsilon_start": 1.0,
    "act_epsilon_final": 0.05,
    "act_epsilon_decay": 50000,
    "buffer_params": {
      "replay_initial": 1000,
      "buffer_capacity": 50000
    }
  },
  "test_config": {
    "load_model_path": "",
    "render": false,
    "num_episodes": 10,
    "max_frames_per_episode": 1000
  }
}